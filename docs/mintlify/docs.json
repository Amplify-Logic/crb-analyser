  "api": {
    "openapi": "openapi.json"
  },
  "seo": {
    "metatags": {
      "og:title": "ReadyPath - AI-Powered Cost-Risk-Benefit Analysis",
      "og:description": "Evidence-based technology decision analysis. ReadyPath uses the CRB framework to replace expensive consulting with AI-powered reports delivered in 24-48 hours."
